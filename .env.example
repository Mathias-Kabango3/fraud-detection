# Copy this file to .env and fill in real values. Never commit .env.

# --- Data paths ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
TRAIN_TRANSACTION_CSV=data/raw/train_transaction.csv
TRAIN_IDENTITY_CSV=data/raw/train_identity.csv

# --- Model artifacts ---
MODEL_DIR=models
MODEL_FILENAME=fraud_xgb.pkl
MODEL_VERSION=0.1.0

# --- MLflow (local tracking) ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=fraud_detection

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# --- API: decision/risk thresholds (optional overrides) ---
DECISION_THRESHOLD=0.5
RISK_MEDIUM_THRESHOLD=0.3
RISK_HIGH_THRESHOLD=0.7

# --- Hugging Face Hub (used on Render to fetch the trained model) ---
# Leave HF_MODEL_REPO_ID blank locally to use the on-disk MODEL_DIR/MODEL_FILENAME instead.
HF_MODEL_REPO_ID=
HF_MODEL_FILENAME=fraud_xgb.pkl
# HF_TOKEN=                # only needed for private HF repos

# --- Training hyperparameters (optional overrides) ---
RANDOM_SEED=42
TEST_SIZE=0.2
N_CV_FOLDS=5
